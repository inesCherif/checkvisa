{
  "name": "checkvisa",
  "private": true,
  "version": "0.1.0",
  "description": "CheckVisa — private Schengen visa-dossier pre-check for applicants in Tunisia. Hybrid AI with Firebase AI Logic (on-device Gemini Nano + cloud Gemini).",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "npm run build && firebase-tools deploy --only hosting,firestore:rules,remoteconfig"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "exceljs": "^4.4.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
