# Copy this file to .env.local and fill in your own Firebase project values.
# Firebase console → Project settings → Your apps → Web app → SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check: reCAPTCHA v3 *site* key (the secret key goes into the Firebase console, never here).
VITE_RECAPTCHA_SITE_KEY=

# Optional: a fixed App Check debug token for localhost (register it in App Check → Manage debug tokens).
VITE_APPCHECK_DEBUG_TOKEN=
